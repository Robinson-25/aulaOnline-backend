# Copia este archivo como ".env" y completa los valores.

PORT=4000
# Orígenes permitidos (opcional, separados por coma). Vacío = cualquiera.
# Ejemplo: CORS_ORIGINS=https://tusitio.com,https://admin.tusitio.com
CORS_ORIGINS=
# Clave secreta para las sesiones. CÁMBIALA por un texto largo y aleatorio antes de publicar.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
# Dirección pública del sitio (se usa en el código QR del certificado y en los correos).
PUBLIC_URL=http://localhost:5173
# Nombre que aparece en certificados y correos
SITE_NAME=Aula Pro Online

# Cuenta de administrador que se crea la primera vez
ADMIN_EMAIL=admin@aulapro.pe
ADMIN_PASSWORD=Admin123!

# --- Pagos manuales (Yape / Plin / transferencia) ---
# OJO: estos son valores de EJEMPLO. Reemplázalos por tus datos reales.
# Deja vacío un método para ocultarlo en el checkout.
YAPE_NUMERO=999 999 999
YAPE_TITULAR=Nombre del titular (ejemplo)
PLIN_NUMERO=
PLIN_TITULAR=
BANCO_NOMBRE=
BANCO_CUENTA=
BANCO_CCI=
BANCO_TITULAR=

# true = la reseña solo se permite al completar el curso. false = basta con haberlo empezado.
RESENA_REQUIERE_COMPLETAR=false

# --- Correo (opcional). Si lo dejas vacío, los correos se muestran en la consola del servidor. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Aula Pro Online <no-responder@tudominio.com>"
